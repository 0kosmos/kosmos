{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kosmos",
  "version": "../package.json",
  "identifier": "com.wraden.kosmos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Kosmos",
        "width": 1280,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 566,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/custom-covers/*"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "kosmos"
        ]
      }
    },
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1MzY0MzU5OUFCNzM3RkYKUldUL043ZWFXVU0yTlgxcnh6Yis1TTR0a25lWmpoTzZad2V6MHN2VjdaazRQQnJrODVRdkZnakEK",
      "endpoints": [
        "https://github.com/0kosmos/kosmos/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  }
}
