{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "steam://run/*"
        },
        {
          "url": "steam://install/*"
        },
        {
          "url": "steam://uninstall/*"
        },
        {
          "url": "steam://nav/downloads"
        },
        {
          "url": "steam://openurl/https://store.steampowered.com/recommended/recommendgame/*"
        },
        {
          "url": "steam://openurl/https://store.steampowered.com/app/*"
        },
        {
          "url": "steam://openurl/https://steamcommunity.com/market/listings/*"
        },
        {
          "url": "steam://friends/message/*"
        },
        {
          "url": "steam://openurl/https://steamcommunity.com/profiles/*"
        },
        {
          "url": "steam://openurl/https://steamcommunity.com/groups/*"
        },
        {
          "url": "steam://open/screenshots"
        },
        {
          "url": "steam://open/screenshots/*"
        },
        {
          "url": "steam://open/friends"
        },
        {
          "url": "steam://openurl/https://steamcommunity.com/sharedfiles/filedetails/*"
        },
        {
          "url": "steam://openurl/https://store.steampowered.com/wishlist/*"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
